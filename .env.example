# ══════════════════════════════════════════════════════
# EPHEMERAL SECRET VAULT — Environment Variables
# ══════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ── Vault Encryption ─────────────────────────────────
# 256-bit Master Encryption Key (64 hexadecimal chars / 32 bytes)
# Generate: node scripts/gen-key.js
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Database ─────────────────────────────────────────
DATABASE_PATH=./data/vault.db

# ── Background Sweeper ───────────────────────────────
# Interval in milliseconds (default: 10000 = 10s)
SWEEPER_INTERVAL_MS=10000

# ══════════════════════════════════════════════════════
# WHATSAPP BUSINESS CLOUD API
# Set these in Vercel Dashboard → Project → Settings → Environment Variables
# NEVER commit real values to source control.
# ══════════════════════════════════════════════════════

# Your permanent system user access token from Meta Business Manager.
# Keep server-side only — NEVER expose to the browser.
WHATSAPP_ACCESS_TOKEN=

# The phone number ID from Meta App Dashboard → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=

# Your WhatsApp Business Account ID (optional — for management API calls).
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Cloud API version (default: v20.0). Update when Meta releases a new version.
WHATSAPP_API_VERSION=v20.0

# Webhook verification token — a random secret you choose and enter in
# Meta App Dashboard → WhatsApp → Configuration → Webhook → Verify Token.
WHATSAPP_VERIFY_TOKEN=

# Webhook app secret — the App Secret from Meta App Dashboard → Settings → Basic.
# Used to verify X-Hub-Signature-256 on incoming webhook POST requests.
WHATSAPP_WEBHOOK_SECRET=

# ══════════════════════════════════════════════════════
# VERCEL CRON AUTHENTICATION
# ══════════════════════════════════════════════════════

# A random 32+ character secret used to authenticate cron requests.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vercel automatically sends this as Authorization: Bearer <CRON_SECRET>
# when invoking cron functions — set the same value in Vercel Dashboard.
CRON_SECRET=

# ══════════════════════════════════════════════════════
# ADMIN AUTHENTICATION (if not already set)
# ══════════════════════════════════════════════════════
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
