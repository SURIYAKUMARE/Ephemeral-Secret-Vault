# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# 256-bit Master Encryption Key (64 hexadecimal characters / 32 bytes)
# Generate a new secure key with: node scripts/gen-key.js
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database Configuration (SQLite in WAL mode)
DATABASE_PATH=./data/vault.db

# Background TTL Sweeper Interval (in milliseconds, default: 10000)
SWEEPER_INTERVAL_MS=10000
