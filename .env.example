# ══════════════════════════════════════════════════════════════════
#  EPHEMERAL SECRET VAULT — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ── Vault Master Encryption Key ───────────────────────────────────
# 256-bit key (64 hex chars). Generate: node scripts/gen-key.js
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Database ──────────────────────────────────────────────────────
DATABASE_PATH=./data/vault.db

# ── Background Sweeper ────────────────────────────────────────────
SWEEPER_INTERVAL_MS=10000

# ══════════════════════════════════════════════════════════════════
#  ADMIN AUTHENTICATION
#  Set ALL of these in Vercel Dashboard → Settings → Environment Variables.
#  NEVER hardcode credentials in source code.
#
#  Quick setup:
#    1. node scripts/create-admin.js --env
#       (prints ADMIN_USERNAME + ADMIN_PASSWORD_HASH)
#    2. Copy the output into Vercel environment variables.
#    3. Login at /admin/login
# ══════════════════════════════════════════════════════════════════

# Admin username displayed in the dashboard
ADMIN_USERNAME=admin

# bcrypt hash of the admin password (cost factor 12).
# Generate: node scripts/create-admin.js --env
# NEVER store the plaintext password here.
ADMIN_PASSWORD_HASH=

# Fallback: plain password for local dev ONLY (not recommended for production).
# If ADMIN_PASSWORD_HASH is set, this is ignored.
# ADMIN_PASSWORD=

# Session signing secret — random 32+ char string.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Session cookie lifetime in milliseconds (default: 24 hours)
ADMIN_SESSION_TTL_MS=86400000

# Rate limit: max login attempts per window (default: 10 per 15 min)
ADMIN_LOGIN_MAX_ATTEMPTS=10
ADMIN_LOGIN_WINDOW_MS=900000

# ══════════════════════════════════════════════════════════════════
#  WHATSAPP BUSINESS CLOUD API
#  Set in Vercel Dashboard. NEVER expose to the browser.
# ══════════════════════════════════════════════════════════════════

# Permanent system user access token from Meta Business Manager
WHATSAPP_ACCESS_TOKEN=

# Phone Number ID from Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (optional)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Cloud API version (default: v20.0)
WHATSAPP_API_VERSION=v20.0

# Webhook verify token — a random secret you choose and enter in Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=

# App Secret from Meta App Dashboard → Settings → Basic
# Used to verify X-Hub-Signature-256 on incoming webhook POST requests
WHATSAPP_WEBHOOK_SECRET=

# ══════════════════════════════════════════════════════════════════
#  VERCEL CRON AUTHENTICATION
# ══════════════════════════════════════════════════════════════════

# Random 32+ char secret. Set in Vercel Dashboard.
# Vercel automatically sends it as Authorization: Bearer <CRON_SECRET>
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ══════════════════════════════════════════════════════════════════
#  RATE LIMITING
# ══════════════════════════════════════════════════════════════════
RATE_LIMIT_CREATE_MAX=30
RATE_LIMIT_BURN_MAX=60

# ══════════════════════════════════════════════════════════════════
#  ACCESS LOG RETENTION
# ══════════════════════════════════════════════════════════════════
ACCESS_LOG_RETENTION_DAYS=30
